      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.625rem;min-height:52px;padding:0.875rem 1.5rem;border:0;border-radius:6px;font-weight:700;font-size:1.0625rem;line-height:1.2;text-decoration:none;cursor:pointer;transition:background-color 0.2s ease;background:var(--primary);color:var(--on-primary);} .ds-btn-primary:hover{background:var(--primary-dark);} .ds-btn-primary:focus-visible{outline:2px solid var(--primary-text);outline-offset:3px;}"
